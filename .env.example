# Copy to .env and fill in. .env is git-ignored.

# --- Postgres (docker-compose reads these too) ---
POSTGRES_USER=gas
POSTGRES_PASSWORD=change-me
POSTGRES_DB=gas_markets
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# --- EIA Open Data API v2 (free key: https://www.eia.gov/opendata/register.php) ---
EIA_API_KEY=

# --- Email alerts (SMTP). For Gmail, use an App Password, not your account password. ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# --- Hosted Postgres (production / GitHub Actions). When set, overrides POSTGRES_* above. ---
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
